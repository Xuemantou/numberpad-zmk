/*
 * numberpad keymap
 *
 * Layer 0: standard numpad, in transform order:
 *   NumLock  /  *  -
 *   7        8  9  +      (2u)
 *   4        5  6
 *   1        2  3  Enter  (2u)
 *   0 (2u)      .
 *
 * Layer 1: hold NumLock. Radio / flashing / Studio unlock, since this PCB has
 * no reset button (module RST is not broken out).
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 1 KP_NUMLOCK  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS
&kp KP_N7        &kp KP_N8     &kp KP_N9        &kp KP_PLUS
&kp KP_N4        &kp KP_N5     &kp KP_N6
&kp KP_N1        &kp KP_N2     &kp KP_N3        &kp KP_ENTER
&kp KP_N0                       &kp KP_DOT
            >;
        };

        sys_layer {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2
&bt BT_CLR  &out OUT_USB  &out OUT_BLE  &studio_unlock
&trans  &trans  &trans
&trans  &trans  &trans  &sys_reset
&trans                  &bootloader
            >;
        };
    };
};
